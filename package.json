{
  "name": "dsh-restart-button",
  "version": "1.0.0",
  "description": "DSH Web 重启按钮：设置页一键重启 dsh-web.service（走 polkit 常驻授权，不依赖市场的一键重启）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "test/validate.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "system"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "systemctl",
    "polkit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/validate.mjs"
  }
}
